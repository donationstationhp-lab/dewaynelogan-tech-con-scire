# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Notion integration (required for --notion flag in etymonline.py) ──────────
#
# 1. Create an integration at https://www.notion.so/my-integrations
#    and copy the "Internal Integration Secret" (starts with "secret_").
# 2. Open your target database in Notion, click "..." → "Add connections",
#    and select your integration.
# 3. The database must have these four properties (exact names):
#      Word              Title
#      Etymology         Text
#      Related Words     Text
#      Date Looked Up    Date

NOTION_TOKEN=secret_your_integration_secret_here
NOTION_DATABASE_ID=your_database_id_here
